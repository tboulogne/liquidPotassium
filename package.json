{
  "name": "liquid-potassium",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-oriented TypeScript SDK and OpenClaw integration for the Infomaniak API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "normalize": "tsx scripts/normalize-openapi.ts",
    "generate": "tsx scripts/generate-types.ts && tsx scripts/generate-operations.ts && tsx scripts/generate-endpoint-tests.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openclaw": "^2026.6.6",
    "typebox": "^1.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

