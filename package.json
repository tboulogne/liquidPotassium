{
  "name": "liquid-potassium",
  "version": "0.1.0",
  "description": "Domain-oriented TypeScript SDK and OpenClaw integration for the Infomaniak API.",
  "license": "Apache-2.0",
  "author": "OpenCow42",
  "homepage": "https://github.com/OpenCow42/liquidPotassium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCow42/liquidPotassium.git"
  },
  "bugs": {
    "url": "https://github.com/OpenCow42/liquidPotassium/issues"
  },
  "keywords": [
    "infomaniak",
    "openapi",
    "sdk",
    "typescript",
    "node",
    "openclaw",
    "kdrive",
    "mail",
    "kchat"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./openclaw/plugin": {
      "types": "./dist/openclaw/plugin.d.ts",
      "default": "./dist/openclaw/plugin.js"
    },
    "./openclaw/tools": {
      "types": "./dist/src/openclaw/infomaniak-tools.d.ts",
      "default": "./dist/src/openclaw/infomaniak-tools.js"
    }
  },
  "files": [
    "dist/src",
    "dist/openclaw",
    "docs",
    "openclaw/skills",
    "README.md",
    "RELEASE.md",
    "SECURITY.md",
    "spec/normalization-report.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci": "npm run check:generated && npm run check:docs && npm run check:no-network && npm run typecheck && npm run build && npm run test:coverage",
    "check:generated": "npm run normalize && npm run generate && git diff --exit-code -- spec/infomaniak.normalized.json spec/normalization-report.json src/generated tests/generated",
    "check:docs": "npm run docs:check && git diff --exit-code -- spec/docs-enrichment-report.json",
    "check:no-network": "tsx scripts/check-no-network-policy.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:fetch": "tsx scripts/fetch-docs-snapshot.ts",
    "docs:check": "tsx scripts/check-docs-snapshot.ts",
    "normalize": "tsx scripts/normalize-openapi.ts",
    "generate": "tsx scripts/generate-types.ts && tsx scripts/generate-operations.ts && tsx scripts/generate-endpoint-tests.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openclaw": "^2026.6.6",
    "typebox": "^1.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
